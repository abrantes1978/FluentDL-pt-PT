  <data name="AppNotificationSamplePayload" xml:space="preserve">
    <value>&lt;toast launch="action=ToastClick"&gt;
      &lt;visual&gt;
        &lt;binding template="ToastGeneric"&gt;
          &lt;text&gt;Notificação da aplicação&lt;/text&gt;
          &lt;text&gt;&lt;/text&gt;
          &lt;image placement="appLogoOverride" hint-crop="circle" src="{0}Assets/WindowIcon.ico"/&gt;
        &lt;/binding&gt;
      &lt;/visual&gt;
      &lt;actions&gt;
        &lt;action content="Definições" arguments="action=Settings"/&gt;
      &lt;/actions&gt;
    &lt;/toast&gt;</value>
  </data>
  <data name="QueueCompletePayload" xml:space="preserve">
    <value>&lt;toast launch="action=ToastClick"&gt;
      &lt;visual&gt;
        &lt;binding template="ToastGeneric"&gt;
          &lt;text&gt;Notificação da fila&lt;/text&gt;
          &lt;text&gt;Todas as tarefas da fila foram concluídas.&lt;/text&gt;
          &lt;image placement="appLogoOverride" hint-crop="circle" src="{0}Assets/WindowIcon.ico"/&gt;
        &lt;/binding&gt;
      &lt;/visual&gt;
    &lt;/toast&gt;</value>
  </data>
